# =============================================================================
# CinTic — Environment Variables Reference
# =============================================================================
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# The variables below are the ONLY ones used by this application.
# No Supabase, Prisma, PostgreSQL, Redis, Upstash, or Stripe is used.
# =============================================================================

# ─────────────────────────────────────────────
# REQUIRED — Application will not start without these
# ─────────────────────────────────────────────

# MongoDB Atlas connection string.
# The password must be URL-encoded if it contains special characters.
# Example: Sakthi@123 → Sakthi%40123
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Signing secret for JWT session tokens. Use a long, random string (32+ chars).
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars

# Groq API key for the CinBot AI concierge chat feature.
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth 2.0 Client ID for "Sign in with Google".
# Create one at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxx.apps.googleusercontent.com

# ─────────────────────────────────────────────
# OPTIONAL — Application works without these, with graceful fallbacks
# ─────────────────────────────────────────────

# Google OAuth Client Secret. Required only if you use server-side Google OAuth token exchange.
# Can be omitted if you only use the Google Identity Services JS SDK on the frontend.
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Base URL of the application. Used to generate email links (e.g., password reset, email verification).
# Defaults to http://localhost:3000 if not set.
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# OPTIONAL — SMTP Email (Password Reset & Email Verification)
# ─────────────────────────────────────────────
# If SMTP_HOST is not set, the application falls back to Ethereal (a test email catcher).
# Ethereal is sufficient for local development — a preview URL is logged to the console.
# For production, configure a real SMTP provider (e.g., SendGrid, Mailgun, Resend, AWS SES).

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# ─────────────────────────────────────────────
# SYSTEM / RUNTIME (do not set in .env normally)
# ─────────────────────────────────────────────

# Set by Node.js / Vercel automatically.
# NODE_ENV=production

# Port the local server listens on (default: 3000).
# PORT=3000

# Override the MongoDB database name (default: "cintic").
# MONGODB_DB=cintic
