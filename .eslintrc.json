{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": "airbnb-base",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "no-console": "warn",
        "no-unused-vars": "warn",
        "no-alert": "off",
        "import/no-unresolved": "off",
        "import/extensions": "off",
        "no-param-reassign": "off",
        "no-plusplus": "off",
        "max-len": [
            "warn",
            {
                "code": 120
            }
        ]
    }
}